{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "react"
    ],
    "lib": [
      "ES2022"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "skills/react-native-skia/examples/**/*.ts",
    "skills/react-native-skia/examples/**/*.tsx"
  ]
}
