      "id": "navigation-deep-link",
      "prompt": "Set up deep links for the settings screen with React Navigation.",
      "reason": "Navigation task."
    },
    {
      "id": "reanimated-view-animation",
      "prompt": "Animate this bottom sheet View with Reanimated and a pan gesture.",
      "reason": "Reanimated and Gesture Handler on native views without Skia; the libraries overlap but the rendering does not."
    },
    {
      "id": "backend-endpoint",
      "prompt": "Add pagination to the /orders endpoint in our Express API.",
      "reason": "Backend task in a repository that happens to contain a mobile app."
    },
    {
      "id": "svg-icon-component",
      "prompt": "Convert these icons to react-native-svg components.",
      "reason": "A different drawing library; Skia guidance would be misleading."
    },
    {
      "id": "web-canvas-2d",
      "prompt": "Draw this chart on an HTML canvas with the 2D context in our Next.js site.",
      "reason": "Browser canvas API, not React Native Skia."
    }
